                </div>
                <div class="product-card">
                    <div class="product-img-placeholder">[ Foto Jaket ]</div>
                    <h3>Jaket Denim Keren</h3>
                    <span class="old-price">Rp 500.000</span>
                    <span class="price">Rp 249.000</span>
                    <button class="add-to-cart">🛒 + Keranjang</button>
                </div>
                <div class="product-card">
                    <div class="product-img-placeholder">[ Foto Tas ]</div>
                    <h3>Tas Ransel Waterproof</h3>
                    <span class="old-price">Rp 450.000</span>
                    <span class="price">Rp 199.000</span>
                    <button class="add-to-cart">🛒 + Keranjang</button>
                </div>
            </div>
        </section>


                