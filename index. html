<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TokoKita - E-Commerce Index</title>
    <style>
        /* Reset & General Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f7f6;
            color: #1a365d; /* Teks Utama: Biru Gelap agar tetap mudah dibaca */
        }

        h1, h2, h3, h4, a, p, span, .price, .old-price {
            color: #0056b3; /* Dominan Teks Warna Biru */
        }

        /* Header Styles */
        header {
            background-color: #ffffff;
            padding: 15px 5%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #004085;
            text-decoration: none;
        }

        nav a {
            text-decoration: none;
            margin: 0 15px;
            font-weight: 600;
            color: #0056b3;
        }

        .search-bar {
            display: flex;
            flex: 1;
            max-width: 400px;
            margin: 0 20px;
        }

        .search-bar input {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #0056b3;
            border-radius: 4px 0 0 4px;
            color: #0056b3;
        }

        .search-bar button {
            background-color: #0056b3;
            color: #ffffff;
            border: none;
            padding: 0 15px;
            border-radius: 0 4px 4px 0;
            cursor: pointer;
        }

        .header-icons span {
            margin-left: 15px;
            cursor: pointer;
            font-weight: bold;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            padding: 60px 5%;
            text-align: center;
            border-bottom: 3px solid #0056b3;
        }

        .hero h1 {
            font-size: 42px;
            margin-bottom: 15px;
            color: #004085;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .cta-btn {
            background-color: #0056b3;
            color: #ffffff !important;
            padding: 12px 30px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 25px;
            display: inline-block;
            transition: 0.3s;
        }

        .cta-btn:hover {
            background-color: #004085;
        }

        /* Main Container */
        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        section {
            margin-bottom: 50px;
        }

        section h2 {
            font-size: 24px;
            margin-bottom: 20px;
            border-left: 5px solid #0056b3;
            padding-left: 10px;
        }

        /* Flash Sale Timer */
        .flash-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .timer {
            background-color: #0056b3;
            color: #ffffff;
            padding: 5px 10px;
            border-radius: 4px;
            font-weight: bold;
        }

        /* Product Grid */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .product-card {
            background-color: #ffffff;
            border: 1px solid #bbdefb;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            position: relative;
            transition: 0.3s;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,86,179,0.15);
        }

        .product-img-placeholder {
            background-color: #e3f2fd;
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            border-radius: 6px;
            font-weight: bold;
        }

        .product-card h3 {
            font-size: 16px;
            margin-bottom: 10px;
        }

        .old-price {
            text-decoration: line-through;
            font-size: 13px;
            opacity: 0.7;
            display: block;
        }

        .price {
            font-size: 18px;
            font-weight: bold;
            display: block;
            margin: 5px 0 15px 0;
        }

        .add-to-cart {
            background-color: transparent;
            border: 1px solid #0056b3;
            color: #0056b3;
            padding: 8px 15px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            width: 100%;
            transition: 0.3s;
        }

        .add-to-cart:hover {
            background-color: #0056b3;
            color: #ffffff;
        }

        /* Categories */
        .category-list {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 15px;
        }

        .category-item {
            background-color: #ffffff;
            border: 1px solid #bbdefb;
            padding: 15px 25px;
            border-radius: 50px;
            text-align: center;
            font-weight: bold;
            cursor: pointer;
            min-width: 120px;
            transition: 0.3s;
        }

        .category-item:hover {
            background-color: #0056b3;
        }
        .category-item:hover span {
            color: #ffffff;
        }

        /* Value Propositions */
        .values {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            background-color: #e3f2fd;
            padding: 30px;
            border-radius: 8px;
            flex-wrap: wrap;
        }

        .value-item {
            flex: 1;
            min-width: 250px;
            text-align: center;
        }

        .value-item h4 {
            font-size: 18px;
            margin-bottom: 8px;
        }

        /* Footer */
        footer {
            background-color: #ffffff;
            border-top: 3px solid #0056b3;
            padding: 40px 5%;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
        }

        footer h4 {
            margin-bottom: 15px;
            font-size: 16px;
        }

        footer p, footer ul {
            font-size: 14px;
            line-height: 1.6;
        }

        footer ul {
            list-style: none;
        }

        footer ul li a {
            text-decoration: none;
            display: block;
            margin-bottom: 8px;
        }

        footer ul li a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <!-- 1. Header -->
    <header>
        <a href="#" class="logo">TokoKita</a>
        <nav>
            <a href="#">Pria</a>
            <a href="#">Wanita</a>
